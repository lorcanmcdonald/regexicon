#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )/.."

# shellcheck source=script/Prelude
source "$DIR/script/Prelude"

"$DIR/script/update"

# Note: Coverage is disabled due to incompatibility with vector library's internal libraries
# See: https://github.com/haskell/cabal/issues/6440
run_haskell sh -c 'cabal new-update && TASTY_QUICKCHECK_TESTS=20 cabal new-test'
